{
  "Version": "2012-10-17",
  "Comment": "Least-privilege policy for the AWS Starter Kit (S3 + Bedrock Nova Pro). IMPORTANT: Replace 'my-unique-student-bucket-name' with the real bucket name before attaching.",
  "Statement": [
    {
      "Sid": "S3UploadAndListOwnBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::my-unique-student-bucket-name",
        "arn:aws:s3:::my-unique-student-bucket-name/*"
      ]
    },
    {
      "Sid": "InvokeBedrockNovaPro",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/amazon.nova-pro-v1:0",
        "arn:aws:bedrock:*:*:inference-profile/us.amazon.nova-pro-v1:0"
      ]
    }
  ]
}
