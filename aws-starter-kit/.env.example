# ============================================================
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit your real .env file or share your keys!
# ============================================================

# The AWS region you enabled Bedrock + created your S3 bucket in.
# Keep everyone in the same region for the event (recommended: us-east-1).
AWS_REGION=us-east-1

# Your AWS credentials (from IAM user Access Keys).
# TIP: If you already ran "aws configure", you can leave these blank
# and the SDK will use your default credentials automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The name of the S3 bucket you created (must be globally unique).
S3_BUCKET_NAME=my-unique-student-bucket-name

# Bedrock model ID. Nova Pro is the default.
# If you get a "model not found / access" error, switch to the
# cross-region inference profile: us.amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Port the local backend server runs on.
PORT=3000
