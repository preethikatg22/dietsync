# ============================================================
#  AWS Kit config reference.
#  The setup generator copies this into your project root as ".env".
#  NEVER commit .env or share your keys.
# ============================================================

# Same region for everything (recommended for the workshop).
AWS_REGION=us-east-1

# Your S3 bucket (must be globally unique). Create it with:
#   aws s3 mb s3://my-unique-student-bucket --region us-east-1
S3_BUCKET_NAME=my-unique-student-bucket

# Default AI model: Nova Lite (cheap + multimodal).
# If access errors occur, try: us.amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Credentials: easiest is to run "aws configure" (leave these blank).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Local server port.
PORT=3000
